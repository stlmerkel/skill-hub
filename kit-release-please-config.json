{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "bump-minor-pre-major": false,
  "label": "autorelease: kit-pending",
  "release-label": "autorelease: kit-tagged",
  "snapshot-label": "autorelease: kit-snapshot",
  "packages": {
    ".": {
      "component": "kit",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "skills",
        ".claude-plugin",
        ".cursor-plugin"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": ".skill-hub/kit.yml"
        }
      ]
    }
  }
}
